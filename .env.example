# Flowboard configuration. Copy this file to ".env" and change what you need.
# Every setting is optional; environment variables override values in .env.

# Port for http://localhost:PORT. If you leave PORT unset and 3000 is busy, Flowboard uses the next free port.
# PORT=3000

# 127.0.0.1 keeps Flowboard private to this computer. Use 0.0.0.0 to allow other devices on your network
# (or on a server). Anyone who can reach the port can create an account.
# HOST=127.0.0.1

# Where the SQLite database lives (relative to the project folder).
# DATA_DIR=data

# Create the demo users and demo board on first run (only when the database has no users).
# SEED=true

# How long a sign-in lasts, in days.
# SESSION_DAYS=30

# --- AI Standup Mode (optional) ---
# Any OpenAI-compatible /chat/completions endpoint works (OpenAI, Azure OpenAI, OpenRouter, Groq,
# a local Ollama or LM Studio server, ...). Without AI_API_KEY the standup uses the built-in rule-based summary.
# Only card titles, list names, member names, dates and counts are sent. Descriptions and comments are not.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=25000

# Mark the session cookie Secure: auto (when the request is HTTPS, e.g. behind Render), true or false.
# COOKIE_SECURE=auto

# Hide the startup banner and info messages.
# QUIET=false
